{
  "max_files": 12,
  "max_lines": 400,
  "default_branch": "main",
  "humans": [
    "Blueturboguy07"
  ],
  "setup_cmds": [
    "npm ci"
  ],
  "test_cmds": [
    "npm test",
    "npm run typecheck"
  ],
  "test_os": [
    "ubuntu-latest"
  ],
  "node_version": "22",
  "setup_uv": false,
  "forbidden_paths": [
    ".github/workflows/**",
    "**/notarize*",
    "**/release.sh",
    "scripts/sign*",
    ".loop/policy.json",
    ".loop/policy/**"
  ],
  "acceptance": {
    "timeout_min": 30,
    "runs": 2
  },
  "release": {
    "dispatch_workflow": null
  }
}
